# For a fresh checkout, copy this file to .env.local. Keep actual keys out of Git.
# If .env.local already exists, add only missing settings; preserve backend values.
# Example URLs only: `npm run backend` writes the actual local Convex configuration.
# Other checkouts can use different ports. These URLs are not secrets.
CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_URL=http://127.0.0.1:3210

# Admin secret for world/eval/admin calls into the kernel. Must match the Convex env var:
#   npx convex env set KERNEL_ADMIN_SECRET <same value>
KERNEL_ADMIN_SECRET=change-me

# Human gateway (npm run gateway) token, shared with the console. Generate it, don't type it:
#   npm run gateway:token
# Optional: GATEWAY_ALLOWED_ORIGINS (comma-separated; default http://127.0.0.1:5173,http://localhost:5173)

# External APEX/DABstep benchmarks: add your existing OpenAI key in .env.local.
# OPENAI_API_KEY authenticates both agent modes and the separate APEX judge.
# Models/prices/token limits live in benchmarks/external-models.json, not env vars:
#   agent: gpt-6.1-sol / medium; judge: gpt-6-astra / low.
# Paid execution stays disabled while that policy has approval: null, even with a key.
# Do not create an approved policy until the user explicitly approves the budget.
OPENAI_API_KEY=
# Optional global inference kill switch: AGENT_LLM=off

# Application agents (AP extraction, parser writing, "why" answers) use OpenAI when
# OPENAI_API_KEY is set (AGENT_PROVIDER=openai|anthropic overrides); Claude is the fallback
# provider. Both are capped by AGENT_MAX_USD (default 15, tracked in var/agent-spend.json,
# or AGENT_SPEND_FILE). Claude needs an explicit ANTHROPIC_API_KEY: the capped client uses
# no ambient auth, SDK retries or server-side fallbacks.
ANTHROPIC_API_KEY=
# AGENT_MAX_USD=15
# AGENT_MODEL=gpt-6.1-sol   (or claude-opus-5-5 with AGENT_PROVIDER=anthropic)

# Where the git-first company memory lives (its own git repo).
MEMORY_REPO=var/memory

# Optional sponsor sandboxes
NESSIE_API_KEY=
CRS_API_KEY=
FACTORY_API_KEY=
