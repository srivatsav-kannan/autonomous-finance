      "id": "r_errors_c",
      "type": "text",
      "x": 1090,
      "y": 1260,
      "width": 470,
      "height": 154,
      "fontSize": 20,
      "strokeColor": "#374151",
      "text": "Escalate unresolved work\nRetry budget / invariant / evidence failure\nException queue with owner + audit trail.\nKeep unknown payment reservations.\nResume only from verified state.\nA new payment needs a separate decision.",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Escalate unresolved work\nRetry budget / invariant / evidence failure\nException queue with owner + audit trail.\nKeep unknown payment reservations.\nResume only from verified state.\nA new payment needs a separate decision.",
