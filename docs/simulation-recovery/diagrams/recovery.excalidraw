      "id": "r_errors_a",
      "type": "text",
      "x": 40,
      "y": 1260,
      "width": 470,
      "height": 154,
      "fontSize": 20,
      "strokeColor": "#374151",
      "text": "Reject before submission\nInvalid amount / stale approval / payee change\nCorrect the cause; reapprove changed terms.\n\n401 / 403 or replay-payload conflict\nPause the adapter; operator fixes the cause.",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reject before submission\nInvalid amount / stale approval / payee change\nCorrect the cause; reapprove changed terms.\n\n401 / 403 or replay-payload conflict\nPause the adapter; operator fixes the cause.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1.5,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 900053,
