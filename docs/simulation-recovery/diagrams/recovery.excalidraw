      "id": "r_evidence_rules",
      "type": "text",
      "x": 40,
      "y": 959,
      "width": 765,
      "height": 160,
      "fontSize": 20,
      "strokeColor": "#64748b",
      "text": "Lost webhook: poll; commit imported page + cursor together.\nDuplicate events: one inbox record; one posting per economic event.\nOut-of-order notices: fetch current facts; never regress state.\nReturn first: fetch original debit + return; post each once.\nMissing evidence: hold an exception; never invent a reversal.\nIncrease sandbox does not retry failed webhook deliveries.",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lost webhook: poll; commit imported page + cursor together.\nDuplicate events: one inbox record; one posting per economic event.\nOut-of-order notices: fetch current facts; never regress state.\nReturn first: fetch original debit + return; post each once.\nMissing evidence: hold an exception; never invent a reversal.\nIncrease sandbox does not retry failed webhook deliveries.",
      "lineHeight": 1.25,
      "autoResize": true
    },
