      "updated": 1,
      "link": null,
      "locked": false,
      "id": "r_errors_b",
      "type": "text",
      "x": 565,
      "y": 1260,
      "width": 470,
      "height": 154,
      "fontSize": 20,
      "strokeColor": "#374151",
      "text": "Retry transient failures\n429: respect Retry-After when provided.\nNetwork / 5xx: payment may be accepted.\nPersist nextAttemptAt; backoff + jitter.\nSame command, same payload, same key.\nCap attempts and total retry time.",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Retry transient failures\n429: respect Retry-After when provided.\nNetwork / 5xx: payment may be accepted.\nPersist nextAttemptAt; backoff + jitter.\nSame command, same payload, same key.\nCap attempts and total retry time.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
