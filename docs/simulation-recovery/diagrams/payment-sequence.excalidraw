    {
      "id": "q_guardrails",
      "type": "text",
      "x": 40,
      "y": 1555,
      "width": 1430,
      "height": 90,
      "text": "DB transactions do not include bank calls. Unknown outcome: keep the same key and provider.\nIf a return arrives first: fetch debit + return transactions; never fabricate a reversal.\nA started attempt cannot be locally voided; resolve its outcome before replacement or releasing funds.\nMissing webhook: poll and use the same evidence pipeline. Persist pages + cursor before downstream matching.",
      "fontSize": 18,
      "strokeColor": "#64748b",
      "seed": 600018,
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "version": 3,
      "versionNonce": 1300018,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "roughness": 1.5,
      "opacity": 100,
      "originalText": "DB transactions do not include bank calls. Unknown outcome: keep the same key and provider.\nIf a return arrives first: fetch debit + return transactions; never fabricate a reversal.\nA started attempt cannot be locally voided; resolve its outcome before replacement or releasing funds.\nMissing webhook: poll and use the same evidence pipeline. Persist pages + cursor before downstream matching.",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
