      "type": "text",
      "x": 1160,
      "y": 1445,
      "width": 520,
      "height": 125,
      "fontSize": 20,
      "text": "Keep reservations. Retry the original command\nand key under provider rules, with a budget.\nExhaustion -> operator exception, not success.\nNo fresh key, provider switch or new payment\nuntil the original outcome is resolved.",
      "strokeColor": "#374151",
