    {
      "id": "s2_ledger_a",
      "type": "text",
      "x": 40,
      "y": 157,
      "width": 475,
      "height": 58,
      "text": "A  Convex: atomic updates; own the invariants.\nB  Formance: reuse a ledger; coordinate two systems.",
      "fontSize": 18,
      "strokeColor": "#374151",
      "seed": 200006,
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1.5,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "version": 2,
      "versionNonce": 900006,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "originalText": "A  Convex: atomic updates; own the invariants.\nB  Formance: reuse a ledger; coordinate two systems.",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "s2_ledger_b",
      "type": "text",
      "x": 40,
      "y": 223,
      "width": 470,
      "height": 54,
      "text": "Blnk: alternative; TigerBeetle: justify with workload.\nOnly one system may own writes to the same ledger.",
      "fontSize": 18,
      "strokeColor": "#64748b",
      "seed": 200007,
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
