      "type": "text",
      "x": 560,
      "y": 157,
      "width": 468,
      "height": 58,
      "text": "A  Node: reuse Git/parsers; own recovery + hosting.\nB  Workflow: durable steps; refactor existing jobs.",
      "fontSize": 18,
      "strokeColor": "#374151",
      "seed": 200010,
      "angle": 0,
