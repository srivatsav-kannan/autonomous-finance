{
  "name": "autonomous-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An agent-native finance department: agents run the finance function, humans oversee.",
  "scripts": {
    "backend": "CONVEX_AGENT_MODE=anonymous convex dev",
    "console": "vite --config console/vite.config.ts",
    "agents": "tsx src/agents/main.ts",
    "world": "tsx src/world/main.ts",
    "eval": "tsx src/evals/main.ts",
    "eval:sheets-bench": "tsx src/evals/spreadsheet/bench.ts",
    "eval:sheets-agent": "tsx src/evals/spreadsheet/agent.ts",
    "bench:prepare": "tsx src/evals/external/main.ts prepare",
    "bench:list": "tsx src/evals/external/main.ts list",
    "bench:run": "tsx src/evals/external/main.ts run",
    "bench:score": "tsx src/evals/external/main.ts score",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gateway": "tsx src/human/gateway.ts",
    "gateway:token": "tsx scripts/gateway-token.ts",
    "smoke": "tsx scripts/smoke-kernel.ts && tsx scripts/smoke-memory.ts",
    "build:console": "vite build --config console/vite.config.ts",
    "design:check": "node .agents/skills/hallmark/scripts/sloplint.mjs console --genre modern-minimal --scope app",
    "design:review": "npm run design:check -- --render",
    "test:bank": "vitest run src/integrations/banking/fake.test.ts",
    "test:payments": "vitest run tests/demo-*.test.ts tests/payments tests/payment-kernel.test.ts",
    "test:contracts": "vitest run src/integrations/banking/increase.test.ts src/integrations/banking/increase-prism.test.ts",
    "demo:local": "tsx scripts/ap-demo.ts local",
    "demo:sandbox": "tsx scripts/ap-demo.ts sandbox",
    "worker:dispatch": "tsx scripts/ap-worker.ts dispatch",
    "worker:evidence": "tsx scripts/ap-worker.ts evidence",
    "typecheck:backend": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "ci:recovery": "node scripts/testing/ci-local-recovery.mjs",
    "test:browser:local": "node scripts/testing/payment-browser-local.mjs",
    "test:browser:staging": "node scripts/testing/payment-browser-staging.mjs",
    "controls": "tsx scripts/control-tests.ts",
    "invoice-mvp:server": "tsx scripts/invoice-mvp-server.ts",
    "invoice-mvp:test": "vitest run src/invoice-mvp",
    "invoice-mvp:init": "tsx scripts/invoice-workspace-init.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "convex": "^1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stoplight/prism-cli": "5.16.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "0.0.65",
    "exceljs": "4.4.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "overrides": {
    "postman-collection": {
      "lodash": "4.18.1",
      "uuid": "11.1.1"
    }
  }
}
